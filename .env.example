# OpenAI API Key for DALL-E 3 Image Generation
OPENAI_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration for persistent cloud database
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Admin Password Configuration (서버 전용, 절대 VITE_ 접두사 사용 금지)
ADMIN_PASSWORD=""

# NAVER API HUB에서 발급받은 Client ID/Secret (하나의 키로 검색, 검색어트렌드, 쇼핑인사이트 API를 모두 사용)
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# Naver Search Ad API (키워드도구) Credentials
NAVER_AD_API_KEY=""
NAVER_AD_SECRET_KEY=""
NAVER_AD_CUSTOMER_ID=""

# Unsplash API Access Key (Optional: for official Unsplash Developer API search)
UNSPLASH_ACCESS_KEY=""

# Cron Job Secret Configuration for /api/cron/update (Bearer Token)
CRON_SECRET="my-super-secret-cron-key-12345"


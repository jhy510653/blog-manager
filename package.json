    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "openai": "^7.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
